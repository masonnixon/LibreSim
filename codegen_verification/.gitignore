# Codegen Verification Directory
# This folder contains generated code for validation against headless simulation

# =============================================================================
# KEEP IN GIT (tracked):
# =============================================================================
# - *.zip files (generated code packages)
# - validation_results/*.md (validation reports)
# - builds/*/output/results.csv (simulation results)

# =============================================================================
# IGNORE (not tracked):
# =============================================================================

# Compiled binaries (these are rebuilt from source)
builds/*/output/simulation
builds/*/output/simulation.exe
builds/*/target/

# Build artifacts
builds/*/*.o
builds/*/*.obj
builds/*/*.a
builds/*/*.lib
builds/*/*.dll
builds/*/*.so
builds/*/*.dylib

# Rust build directories
builds/*/target/

# Python bytecode
builds/*/__pycache__/
builds/*/*.pyc
builds/*/*.pyo

# Temporary/test directories (debugging artifacts)
*_temp/
*_test/
temp_*/

# IDE artifacts
.vscode/
.idea/
