{
  "id": "example-sensor-fusion-tracking",
  "metadata": {
    "name": "Sensor Fusion Alpha-Beta-Gamma Tracking",
    "description": "Demonstrates tracking filters from the Sensor Fusion Toolbox: An accelerating target is tracked using both Alpha-Beta and Alpha-Beta-Gamma filters, showing how the ABG filter can estimate acceleration while AB cannot.",
    "author": "LibreSim Examples",
    "createdAt": "2024-12-31T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.0.0"
  },
