{
  "id": "example-step-response-info",
  "metadata": {
    "name": "Step Response - Time Domain Analysis",
    "description": "Compares step response characteristics of three second-order systems with different damping ratios: overdamped (zeta=2), critically damped (zeta=1), and underdamped (zeta=0.3). Each Transfer Function block connects to its Step Info block for automatic coefficient extraction. The step response shows rise time, settling time, overshoot, and steady-state behavior.",
    "author": "LibreSim Examples",
    "createdAt": "2024-01-01T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.1.0"
  },
  "blocks": [
    {
      "id": "tf_overdamped",
      "type": "transfer_function",
      "name": "Overdamped TF",
      "position": { "x": 50, "y": 80 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 4, 1]
      },
      "inputPorts": [
        { "id": "tf_overdamped-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_overdamped-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "step_overdamped",
      "type": "step_info",
      "name": "Overdamped (zeta=2)",
      "position": { "x": 200, "y": 80 },
      "parameters": {
        "simulationTime": 20,
        "numPoints": 1000,
        "settlingPercent": 2
      },
      "inputPorts": [
        { "id": "step_overdamped-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "step_overdamped-out", "name": "settlingTime", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "tf_critical",
      "type": "transfer_function",
      "name": "Critical TF",
      "position": { "x": 50, "y": 180 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 2, 1]
      },
      "inputPorts": [
        { "id": "tf_critical-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_critical-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "step_critical",
      "type": "step_info",
      "name": "Critical (zeta=1)",
      "position": { "x": 200, "y": 180 },
      "parameters": {
        "simulationTime": 15,
        "numPoints": 1000,
        "settlingPercent": 2
      },
      "inputPorts": [
        { "id": "step_critical-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "step_critical-out", "name": "settlingTime", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "tf_underdamped",
      "type": "transfer_function",
      "name": "Underdamped TF",
      "position": { "x": 50, "y": 280 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 0.6, 1]
      },
      "inputPorts": [
        { "id": "tf_underdamped-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_underdamped-out", "name": "out", "dataType": "double", "dimensions": [1] }
