{
  "id": "example-pole-zero-map",
  "metadata": {
    "name": "Pole-Zero Map - System Stability",
    "description": "Demonstrates pole-zero mapping for stability analysis. Shows three systems: (1) Stable underdamped with complex poles at -1+/-2j, (2) Marginally stable with poles on imaginary axis, (3) Unstable with a pole in the right-half plane. Each Transfer Function block connects to its Pole-Zero Map block for automatic coefficient extraction.",
    "author": "LibreSim Examples",
    "createdAt": "2024-01-01T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.1.0"
  },
  "blocks": [
    {
      "id": "tf_stable",
      "type": "transfer_function",
      "name": "Stable TF",
      "position": { "x": 50, "y": 80 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 2, 5]
      },
      "inputPorts": [
        { "id": "tf_stable-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_stable-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "pz_stable",
      "type": "pole_zero_map",
      "name": "Stable System",
      "position": { "x": 200, "y": 80 },
      "parameters": {},
      "inputPorts": [
        { "id": "pz_stable-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "pz_stable-out", "name": "isStable", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "tf_marginal",
      "type": "transfer_function",
      "name": "Marginal TF",
      "position": { "x": 50, "y": 180 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 0, 1]
      },
      "inputPorts": [
        { "id": "tf_marginal-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_marginal-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "pz_marginal",
      "type": "pole_zero_map",
      "name": "Marginally Stable",
      "position": { "x": 200, "y": 180 },
      "parameters": {},
      "inputPorts": [
        { "id": "pz_marginal-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "pz_marginal-out", "name": "isStable", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "tf_unstable",
      "type": "transfer_function",
      "name": "Unstable TF",
      "position": { "x": 50, "y": 280 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, -1, -2]
      },
      "inputPorts": [
        { "id": "tf_unstable-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf_unstable-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "pz_unstable",
      "type": "pole_zero_map",
      "name": "Unstable System",
      "position": { "x": 200, "y": 280 },
      "parameters": {},
      "inputPorts": [
        { "id": "pz_unstable-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "pz_unstable-out", "name": "isStable", "dataType": "double", "dimensions": [1] }
      ]
    }
  ],
  "connections": [
    {
      "id": "conn1",
      "sourceBlockId": "tf_stable",
      "sourcePortId": "tf_stable-out",
      "targetBlockId": "pz_stable",
      "targetPortId": "pz_stable-in"
    },
    {
      "id": "conn2",
      "sourceBlockId": "tf_marginal",
      "sourcePortId": "tf_marginal-out",
      "targetBlockId": "pz_marginal",
      "targetPortId": "pz_marginal-in"
    },
    {
      "id": "conn3",
      "sourceBlockId": "tf_unstable",
      "sourcePortId": "tf_unstable-out",
      "targetBlockId": "pz_unstable",
      "targetPortId": "pz_unstable-in"
    }
  ],
  "simulationConfig": {
    "solver": "rk4",
    "startTime": 0,
    "stopTime": 1,
    "stepSize": 0.1
  }
}
