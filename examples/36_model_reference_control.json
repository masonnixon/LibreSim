{
  "id": "example-model-reference",
  "metadata": {
    "name": "Model Reference Control",
    "description": "Demonstrates the Model Reference block for adaptive control. The reference model defines desired closed-loop behavior, and the controller aims to match plant output to reference model output.",
    "author": "LibreSim Examples",
    "createdAt": "2024-12-31T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.0.0"
  },
  "blocks": [
    {
      "id": "command",
      "type": "step",
      "name": "Command",
      "position": { "x": 50, "y": 200 },
      "parameters": { "stepTime": 1, "initialValue": 0, "finalValue": 1 },
      "inputPorts": [],
      "outputPorts": [{ "id": "command-out", "name": "out", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "ref_model",
      "type": "model_reference",
      "name": "Reference Model",
      "position": { "x": 200, "y": 100 },
      "parameters": {
        "A": [[-2]],
        "B": [[2]],
        "C": [[1]],
        "D": [[0]],
        "initialState": [0]
      },
      "inputPorts": [{ "id": "ref_model-in", "name": "r", "dataType": "double", "dimensions": [1] }],
      "outputPorts": [{ "id": "ref_model-out", "name": "y", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "tracking_error",
      "type": "sum",
      "name": "Tracking Error",
      "position": { "x": 400, "y": 200 },
      "parameters": { "signs": "+-" },
      "inputPorts": [
        { "id": "tracking_error-in1", "name": "in1", "dataType": "double", "dimensions": [1] },
        { "id": "tracking_error-in2", "name": "in2", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [{ "id": "tracking_error-out", "name": "out", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "pid",
      "type": "pid_controller",
      "name": "Tracking PID",
      "position": { "x": 550, "y": 200 },
      "parameters": { "Kp": 10, "Ki": 5, "Kd": 1, "N": 50, "initialConditionI": 0 },
      "inputPorts": [{ "id": "pid-in", "name": "in", "dataType": "double", "dimensions": [1] }],
      "outputPorts": [{ "id": "pid-out", "name": "out", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "plant",
      "type": "transfer_function",
      "name": "Actual Plant",
      "position": { "x": 700, "y": 200 },
      "parameters": { "numerator": [1], "denominator": [1, 3, 2] },
      "inputPorts": [{ "id": "plant-in", "name": "in", "dataType": "double", "dimensions": [1] }],
      "outputPorts": [{ "id": "plant-out", "name": "out", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "scope_tracking",
      "type": "scope",
      "name": "Reference vs Plant",
      "position": { "x": 900, "y": 150 },
      "parameters": { "numInputs": 3 },
      "inputPorts": [
        { "id": "scope_tracking-in1", "name": "in1", "dataType": "double", "dimensions": [1] },
        { "id": "scope_tracking-in2", "name": "in2", "dataType": "double", "dimensions": [1] },
        { "id": "scope_tracking-in3", "name": "in3", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": []
    },
    {
      "id": "scope_error",
      "type": "scope",
      "name": "Tracking Error",
      "position": { "x": 550, "y": 320 },
      "parameters": { "numInputs": 1 },
      "inputPorts": [{ "id": "scope_error-in1", "name": "in1", "dataType": "double", "dimensions": [1] }],
      "outputPorts": []
    }
  ],
  "connections": [
    { "id": "c1", "sourceBlockId": "command", "sourcePortId": "command-out", "targetBlockId": "ref_model", "targetPortId": "ref_model-in" },
    { "id": "c2", "sourceBlockId": "ref_model", "sourcePortId": "ref_model-out", "targetBlockId": "tracking_error", "targetPortId": "tracking_error-in1" },
    { "id": "c3", "sourceBlockId": "plant", "sourcePortId": "plant-out", "targetBlockId": "tracking_error", "targetPortId": "tracking_error-in2" },
    { "id": "c4", "sourceBlockId": "tracking_error", "sourcePortId": "tracking_error-out", "targetBlockId": "pid", "targetPortId": "pid-in" },
    { "id": "c5", "sourceBlockId": "pid", "sourcePortId": "pid-out", "targetBlockId": "plant", "targetPortId": "plant-in" },
    { "id": "c6", "sourceBlockId": "command", "sourcePortId": "command-out", "targetBlockId": "scope_tracking", "targetPortId": "scope_tracking-in1" },
    { "id": "c7", "sourceBlockId": "ref_model", "sourcePortId": "ref_model-out", "targetBlockId": "scope_tracking", "targetPortId": "scope_tracking-in2" },
    { "id": "c8", "sourceBlockId": "plant", "sourcePortId": "plant-out", "targetBlockId": "scope_tracking", "targetPortId": "scope_tracking-in3" },
    { "id": "c9", "sourceBlockId": "tracking_error", "sourcePortId": "tracking_error-out", "targetBlockId": "scope_error", "targetPortId": "scope_error-in1" }
  ],
  "simulationConfig": {
    "solver": "rk4",
    "startTime": 0,
    "stopTime": 10,
    "stepSize": 0.01
  }
}
