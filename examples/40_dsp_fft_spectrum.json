{
  "id": "example-dsp-fft-spectrum",
  "metadata": {
    "name": "DSP FFT Spectrum Analysis",
    "description": "Demonstrates DSP Toolbox blocks: A composite signal (sum of two sine waves at 10Hz and 25Hz) is windowed with a Hamming window and transformed using FFT to show the frequency spectrum. Shows SineWave, Sum, WindowFunction, and FFT blocks.",
    "author": "LibreSim Examples",
    "createdAt": "2024-12-31T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.0.0"
  },
