{
  "id": "example-bode-plot-analysis",
  "metadata": {
    "name": "Bode Plot - Frequency Response Analysis",
    "description": "Demonstrates Bode plot analysis for a second-order low-pass system H(s) = 1/(s^2 + 0.5s + 1). The Transfer Function block connects to the Bode Plot block for automatic coefficient extraction. Shows magnitude and phase response, gain/phase margins, and bandwidth. The system has natural frequency wn=1 rad/s and damping ratio zeta=0.25, resulting in resonant peaking near the natural frequency.",
    "author": "LibreSim Examples",
    "createdAt": "2024-01-01T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.1.0"
  },
  "blocks": [
    {
      "id": "tf1",
      "type": "transfer_function",
      "name": "H(s)",
      "position": { "x": 100, "y": 100 },
      "parameters": {
        "numerator": [1],
        "denominator": [1, 0.5, 1]
      },
      "inputPorts": [
        { "id": "tf1-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "tf1-out", "name": "out", "dataType": "double", "dimensions": [1] }
      ]
    },
    {
      "id": "bode1",
      "type": "bode_plot",
      "name": "Bode Plot",
      "position": { "x": 300, "y": 100 },
      "parameters": {
        "minFrequency": 0.01,
        "maxFrequency": 10,
        "numPoints": 200
      },
      "inputPorts": [
        { "id": "bode1-in", "name": "in", "dataType": "double", "dimensions": [1] }
      ],
      "outputPorts": [
        { "id": "bode1-out", "name": "dcGain", "dataType": "double", "dimensions": [1] }
      ]
    }
  ],
  "connections": [
    {
      "id": "conn1",
      "sourceBlockId": "tf1",
      "sourcePortId": "tf1-out",
      "targetBlockId": "bode1",
      "targetPortId": "bode1-in"
    }
  ],
  "simulationConfig": {
    "solver": "rk4",
    "startTime": 0,
    "stopTime": 1,
    "stepSize": 0.1
  }
}
