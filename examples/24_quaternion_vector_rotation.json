{
  "id": "example-quaternion-rotate-vector",
  "metadata": {
    "name": "Quaternion Vector Rotation",
    "description": "Demonstrates rotating a 3D vector using quaternions. Shows a unit vector being rotated by a time-varying quaternion, useful for transforming vectors between reference frames in aerospace applications.",
    "author": "LibreSim Examples",
    "createdAt": "2024-12-31T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.0.0"
  },
