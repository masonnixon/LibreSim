      "type": "constant",
      "name": "ωx (Roll Rate)",
      "position": { "x": 50, "y": 100 },
      "parameters": { "value": 0.1 },
      "inputPorts": [],
      "outputPorts": [{ "id": "omega_x-out", "name": "out", "dataType": "double", "dimensions": [1] }]
    },
    {
      "id": "omega_y",
      "type": "constant",
      "name": "ωy (Pitch Rate)",
