{
  "id": "example-quaternion-attitude",
  "metadata": {
    "name": "Quaternion Attitude Propagation",
    "description": "Demonstrates aerospace quaternion blocks: propagate attitude using angular velocity, normalize quaternions, and convert to Euler angles for visualization. Similar to Simulink Aerospace Blockset examples.",
    "author": "LibreSim Examples",
    "createdAt": "2024-12-31T00:00:00Z",
    "modifiedAt": "2024-12-31T00:00:00Z",
    "version": "1.0.0"
  },
  "blocks": [
